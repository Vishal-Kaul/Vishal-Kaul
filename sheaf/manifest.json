{
  "manifest_version": 3,
  "name": "Sheaf",
  "version": "0.1.0",
  "description": "Save and categorize web pages in one keystroke.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "activeTab", "scripting", "alarms", "downloads"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/idle-16.png",
      "32": "assets/icons/idle-32.png",
      "48": "assets/icons/idle-48.png",
      "128": "assets/icons/idle-128.png"
    }
  },
  "commands": {
    "save-and-close": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Save this page and close the tab"
    }
  },
  "icons": {
    "16": "assets/icons/idle-16.png",
    "32": "assets/icons/idle-32.png",
    "48": "assets/icons/idle-48.png",
    "128": "assets/icons/idle-128.png"
  }
}
